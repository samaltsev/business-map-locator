{
  "apiVersion": 3,
  "name": "business-map/locator",
  "version": "1.3.2-beta40.7",
  "title": "Business Map Locator",
  "category": "widgets",
  "icon": "location-alt",
  "description": "Interactive business locator with map, search and filters.",
  "textdomain": "business-map-locator",
  "attributes": {
    "layout": {
      "type": "string",
      "default": "split"
    },
    "category": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "categoryMode": {
      "type": "string",
      "default": "visible"
    },
    "cityMode": {
      "type": "string",
      "default": "visible"
    },
    "perPage": {
      "type": "number",
      "default": 24
    },
    "height": {
      "type": "number",
      "default": 620
    },
    "search": {
      "type": "boolean",
      "default": true
    },
    "filters": {
      "type": "boolean",
      "default": true
    },
    "geolocation": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  }
}
