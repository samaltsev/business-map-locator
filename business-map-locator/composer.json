{
  "name": "business-map-locator/business-map-locator",
  "description": "Business locator platform for WordPress with map providers, geographic search, CSV import and REST API.",
  "type": "wordpress-plugin",
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^6.4",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "BusinessMapLocator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BusinessMapLocator\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
